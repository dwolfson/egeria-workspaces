# ─────────────────────────────────────────────────────────────────────────────
# egeria-freshstart — environment configuration template
# Copy this file to .env and fill in values for your environment.
# .env is gitignored; .env.example is committed and kept up to date.
# ─────────────────────────────────────────────────────────────────────────────

# ── Host / network ────────────────────────────────────────────────────────────
# Fully-qualified hostname of this machine.
HOST_FQDN=myhost.local

# Kafka bootstrap address reachable from inside containers.
KAFKA_BOOTSTRAP_SERVERS=myhost.local:9194

CONFIG_JSON=""

# ── Egeria Advisor / Resource Explorer (trellis) ─────────────────────────────
# Portal tiles that hand the signed-in user off to the trellis apps over SSO,
# carrying that user's own freshstart Egeria token — so the Advisor / Resource
# Explorer instance must target freshstart's Egeria (8443, fs-view-server).
# gen-env.sh keeps these three across re-runs.
# URLs are sent to browsers; a localhost host is rewritten to the host the
# browser used to reach the portal. Unset = that tile and its handoff stay inert.
# Typical: http://localhost:7880/ (Advisor), http://localhost:7810/ (Resource Explorer).
EGERIA_ADVISOR_URL=
EGERIA_RESOURCE_EXPLORER_URL=
# Shared HS256 secret: must equal Advisor's ADVISOR_PORTAL_SECRET (Resource
# Explorer reads the same value as TRELLIS_PORTAL_SECRET). Blank disables the handoff.
EGERIA_ADVISOR_SSO_SECRET=

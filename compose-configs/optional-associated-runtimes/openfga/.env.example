# Copy to .env and fill in. .env is git-ignored; never commit it.

# Image (pinned).
OPENFGA_IMAGE=openfga/openfga:v1.23.0

# Datastore: the `openfga` database on egeria-shared-postgres:5442.
# Set the same password on the role (README, "Datastore").
# Generate one with: openssl rand -hex 24
OPENFGA_DB_PASSWORD=
OPENFGA_DB_USER=openfga_admin
OPENFGA_DB_HOST=egeria-shared-postgres
OPENFGA_DB_PORT=5442
OPENFGA_DB_NAME=openfga
OPENFGA_DB_SSLMODE=disable

# Host ports (bound to 127.0.0.1). Containers on egeria_network use
# egeria-optional-openfga:8080 (HTTP) and :8081 (gRPC) whatever these are.
OPENFGA_HTTP_PORT=8090
OPENFGA_GRPC_PORT=8091
OPENFGA_PLAYGROUND_PORT=3030

# Playground UI (off by default).
OPENFGA_PLAYGROUND_ENABLED=false

# API authentication: none, or preshared with a comma-separated key list
# (generate each with: openssl rand -hex 32).
OPENFGA_AUTHN_METHOD=none
OPENFGA_AUTHN_PRESHARED_KEYS=

# Optional. Copy to .env only to change a default; .env is git-ignored.
# This config holds no secrets: NATS runs without client auth, on 127.0.0.1 only.

# Image (pinned).
NATS_IMAGE=nats:2.15.3-alpine

# Host ports (bound to 127.0.0.1). Containers on egeria_network use
# egeria-optional-nats:4222 whatever these are.
NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
